void detectarpocision() {
  distIz = IZ.ping_cm();
  delay(40);
  distFe = FE.ping_cm();
  delay(40);
  distDe = DE.ping_cm();
  delay(40);

  if (distIz >= 0 && distIz < 30 && distFe > 150 && distFe < 200 && distDe > 25 && distDe < 100) {
    digitalWrite(ledazul, LOW);
    digitalWrite(ledrojo, HIGH);
    estadopos = 1;
  }
  if (distIz > 10 && distIz < 55 && distFe > 150 && distFe < 200 && distDe > 10 && distDe < 55) {
    digitalWrite(ledazul, HIGH);
    digitalWrite(ledrojo, HIGH);
    estadopos = 2;
  }
  if (distIz > 25 && distIz < 100 && distFe > 150 && distFe < 200 && distDe >= 0 && distDe < 30) {
    digitalWrite(ledazul, HIGH);
    digitalWrite(ledrojo, LOW);
    estadopos = 3;
  }
  if (distIz >= 0 && distIz < 30 && distFe > 90 && distFe < 150 && distDe > 25 && distDe < 100) {
    parpadeoRojo();
    estadopos = 4;
  }
  if (distIz > 10 && distIz < 55 && distFe > 90 && distFe < 150 && distDe > 10 && distDe < 55) {
    parpadeoAmbos();
    estadopos = 5;
  }
  if (distIz > 25 && distIz < 100 && distFe > 90 && distFe < 150 && distDe >= 0 && distDe < 30) {
    parpadeoAzul();
    estadopos = 6;
  }
}

