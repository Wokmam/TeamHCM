void detectarpocisioninversoia() {
  distIz = IZ.ping_cm();
  delay(40);
  distFe = FE.ping_cm();
  delay(40);
  distDe = DE.ping_cm();
  delay(40);

  if (distFe >= 150 && distFe <= 200) {
    if (distDe <= 30 && distIz > 30) {
      digitalWrite(ledazul, HIGH); digitalWrite(ledrojo, LOW); estadoposinverso = 1;
    } else if (distIz > 30 && distDe > 30) {
      digitalWrite(ledazul, HIGH); digitalWrite(ledrojo, HIGH); estadoposinverso = 2;
    } else if (distIz <= 30 && distDe > 30) {
      digitalWrite(ledazul, LOW); digitalWrite(ledrojo, HIGH); estadoposinverso = 3;
    } else {
      estadoposinverso = 3;
    }
  } else if (distFe > 90 && distFe < 150) {
    if (distDe <= 30 && distIz > 30) {
      parpadeoAzul(); estadoposinverso = 4;
    } else if (distIz > 30 && distDe > 30) {
      parpadeoAmbos(); estadoposinverso = 5;
    } else if (distIz <= 30 && distDe > 30) {
      parpadeoRojo(); estadoposinverso = 6;
    }
  }
}
