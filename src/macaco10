void setup() {
  Serial.begin(9600);
  Wire.begin();
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ledrojo, OUTPUT);
  pinMode(ledazul, OUTPUT);
  pinMode(pin, INPUT);
  pinMode(pin2, INPUT);
  pinMode(trigIZ, OUTPUT);
  pinMode(echoIZ, INPUT);
  pinMode(trigME, OUTPUT);
  pinMode(echoME, INPUT);
  pinMode(trigDE, OUTPUT);
  pinMode(echoDE, INPUT);

  Last_Clk = digitalRead(Clk);
  attachInterrupt(digitalPinToInterrupt(Clk), ENCODER, CHANGE);
  mpu.begin();
  EEPROM.get(0, calData);
  mpu.setGyroOffsets(calData.gx, calData.gy, calData.gz);
  myservo.attach(PIN_SERVO);
  myservo.write(centroServo);
  Serial.println("Sistema iniciado.");

  int pullDowm = digitalRead(pin);
  if (pullDowm == 1) {
    pulldowm = 1;
  } else if (pullDowm == 0) {
    pulldowm = 0;
  }
  delay(700);
}

void loop() {
  julio = digitalRead(pin2);

  if (julio == 1 && Anyi == false) {
    Anyi = true;
  }

  if (Anyi == true) {
    /////////////////////////////////////////////////inversion de sentido antiorario
    if (pulldowm == 1) {
      if (estadoposinverso == 0) {
        actualizarDistancias();
        detectarpocisioninversoia();
      } else if (estadoposinverso == 1) {
        actualizarDistancias();
        posicion1inverso();
      } else if (estadoposinverso == 2) {
        actualizarDistancias();
        posicion2inverso();
      } else if (estadoposinverso == 3) {
        actualizarDistancias();
        posicion3inverso();
      } else if (estadoposinverso == 4) {
        actualizarDistancias();
        posicion4inversodelante();
      } else if (estadoposinverso == 5) {
        actualizarDistancias();
        posicion5inversodelante();
      } else if (estadoposinverso == 6) {
        actualizarDistancias();
        posicion6inversodelante();
      }
    } else if (pulldowm == 0) {
      ////////////////////////////////////////////////////////////sentido HORARIO
      if (estadopos == 0) {
        actualizarDistancias();
        detectarpocisionia();
      } else if (estadopos == 1) {
        actualizarDistancias();
        posicion1velocidad200();
      } else if (estadopos == 2) {
