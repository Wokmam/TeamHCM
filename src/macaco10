      }
    }
  }
}

// FUNCIONES DE CONTROL
void actualizarDistancias() {
  if (millis() - ultimoPing >= intervaloPing) {
    distIz = IZ.ping_cm();
    distDe = DE.ping_cm();
    distFe = FE.ping_cm();
    ultimoPing = millis();
  }
}

void controlarServoIMU() {
  mpu.update();
  yaw = mpu.getAngleZ();
  error = setpoint - yaw;
  float correccionPared = 0.0;
  
  if (modoCentradoActivo == true) { // Ahora actúa como "Seguidor de Pared Izquierda"
    float errorIzq = 0;
    
    if (distIz > 0) {
      // Si distIz > 15, errorIzq es negativo -> gira a la izquierda para acercarse.
      // Si distIz < 15, errorIzq es positivo -> gira a la derecha para alejarse.
      errorIzq = setpointIzq - distIz; 
    } else {
      // Si no detecta la pared izquierda (0), asumimos que nos hemos alejado y forzamos giro a la izquierda
      errorIzq = -25.0; 
    }
    
    correccionPared = errorIzq * Kp_pared;
    
    // Seguridad: Si el sensor derecho detecta que estamos muy cerca de la pared derecha (< 20 cm),
    // forzamos un giro a la izquierda para evitar el choque, sin importar la lectura izquierda.
    if (distDe > 0 && distDe < 20) {
      correccionPared -= 20.0; 
    }

    // Limitamos el ajuste máximo a 30 grados para que no gire bruscamente
    correccionPared = constrain(correccionPared, -30.0, 30.0);
  }
  
  // Sumamos la corrección de la pared al control normal de la IMU
  salida = (Kp * error) + correccionPared;
  anguloServo = centroServo + salida;
  anguloServo = constrain(anguloServo, 71, 93);  // Ajusta estos límites a tu mecánica
  myservo.write(anguloServo);

  Serial.print("CM: ");
  Serial.print(obtenerDistanciaCm());
  Serial.print(" | Iz: ");
  Serial.print(distIz);
  Serial.print(" | Fe: ");
  Serial.print(distFe);
  Serial.print(" | De: ");
  Serial.print(distDe);
  Serial.print(" | Seguidor Izq: ");
  Serial.println(modoCentradoActivo ? "ON" : "OFF");
}

void controlarServoIMUpro() {
  mpu.update();
  yaw = mpu.getAngleZ();
  error = setpoint - yaw;
  float correccionPared = 0.0;
  
  if (modoCentradoActivo == true) { 
    float errorIzq = 0;
    
    if (distIz > 0) {
      errorIzq = setpointIzq - distIz; 
    } else {
      errorIzq = -25.0; 
    }
    
    correccionPared = errorIzq * Kp_pared;
    
    if (distDe > 0 && distDe < 30) {
      correccionPared -= 20.0; 
    }

    correccionPared = constrain(correccionPared, -30.0, 30.0);
  }
  
  salida = (Kp * error) + correccionPared;
  anguloServo = centroServo + salida;
  anguloServo = constrain(anguloServo, 65, 89);  // Ajusta estos límites a tu mecánica
  myservo.write(anguloServo);

  Serial.print("CM: ");
  Serial.print(obtenerDistanciaCm());
  Serial.print(" | Iz: ");
  Serial.print(distIz);
  Serial.print(" | Fe: ");
  Serial.print(distFe);
  Serial.print(" | De: ");
  Serial.print(distDe);
  Serial.print(" | Seguidor Izq: ");
  Serial.println(modoCentradoActivo ? "ON" : "OFF");
}

void controlarMotor200() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, velocidadMotor);
}

void controlarMotor100() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, 150);
}

void ENCODER() {
  int A = digitalRead(Clk);
  int B = digitalRead(Dt);
  if (Last_Clk == 0 && A == 1) {
    if (B == 0) ticks++;
    else ticks--;
  } else if (Last_Clk == 1 && A == 0) {
    if (B == 1) ticks++;
    else ticks--;
  }
  Last_Clk = A;
}

float obtenerDistanciaCm() {
  long ticksActuales;
  noInterrupts();
  ticksActuales = ticks;
  interrupts();
  return ticksActuales * CM_POR_TICK;
}

